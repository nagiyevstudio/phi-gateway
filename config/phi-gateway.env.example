# Copy to /opt/phi-gateway/config/phi-gateway.env on the VPS.
# Do not commit real values.

NODE_ENV=production
PORT=3200

# Optional public origin after DNS/nginx is configured.
PUBLIC_BASE_URL=https://phi-gateway.logitaka.com

# Config paths on VPS.
PHI_GATEWAY_CLIENTS_CONFIG=/opt/phi-gateway/config/clients.json
PHI_GATEWAY_PROVIDERS_CONFIG=/opt/phi-gateway/config/providers.json
PHI_GATEWAY_MODEL_ALIASES_CONFIG=/opt/phi-gateway/config/model-aliases.json
PHI_GATEWAY_LOG_DIR=/opt/phi-gateway/logs

